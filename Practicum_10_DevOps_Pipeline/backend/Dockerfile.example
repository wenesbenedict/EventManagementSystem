# Example only: place this as backend/Dockerfile after confirming your app entry point.
FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
EXPOSE 8000
# Change main:app if your FastAPI module/object has a different name.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
